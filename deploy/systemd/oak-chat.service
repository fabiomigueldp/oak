[Unit]
Description=Oak bounded web chat bridge
After=docker.service oak.service
[Service]
User=oak
Group=oak
ExecStart=/usr/bin/python3 /srv/oak/chat-server.py
Restart=always
RestartSec=5
MemoryMax=128M
CPUQuota=15%
TasksMax=80
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
