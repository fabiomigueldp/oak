[Unit]
Description=Oak administrative queue and status worker
After=network.target oak-control-agent.service
Wants=oak-control-agent.service

[Service]
Type=simple
User=oak-control
Group=oak-control
WorkingDirectory=/opt/oak-control/current
Environment=OAK_ADMIN_STATE=/var/lib/oak-control
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/oak-control/current/.venv/bin/python -m admin worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/oak-control
InaccessiblePaths=/srv/oak/server /srv/oak/backups /srv/oak/control
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=384M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
