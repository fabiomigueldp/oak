[Unit]
Description=Queue an Oak recovery point through the unified policy engine
After=oak-control.service
Wants=oak-control.service

[Service]
Type=oneshot
User=oak-control
Group=oak-control
WorkingDirectory=/opt/oak-control/current
Environment=OAK_ADMIN_STATE=/var/lib/oak-control
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/oak-control/current/.venv/bin/python -m admin backup
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/oak-control
UMask=0077
TimeoutStartSec=30
